generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  PROPIETARIA
  CLIENTE
}

enum TipoLimpieza {
  ESTANDAR
  PROFUNDA
  MUDANZA_ENTRADA
  MUDANZA_SALIDA
  POST_CONSTRUCCION
  OFICINA
}

enum TipoPropiedad {
  DEPARTAMENTO
  CASA
}

enum EstadoCotizacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum EstadoCita {
  PROGRAMADA
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  ANULADO
}

enum MetodoPago {
  EFECTIVO
  ZELLE
  TARJETA
  TRANSFERENCIA
  VENMO
  CASHAPP
  CHEQUE
  OTRO
}

enum OrigenVenta {
  CITA
  MANUAL
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(CLIENTE)
  activo    Boolean  @default(true)
  clienteId String?  @unique
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cotizacionesRevisadas Cotizacion[] @relation("RevisadoPor")

  @@map("usuarios")
}

model ServicioTipo {
  id              String          @id @default(uuid())
  clave           String          @unique
  nombre          String
  etiquetaTamanio String
  activo          Boolean         @default(true)
  orden           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  opciones        OpcionTamanio[]

  @@map("servicio_tipos")
}

model OpcionTamanio {
  id             String       @id @default(uuid())
  servicioTipoId String
  servicioTipo   ServicioTipo @relation(fields: [servicioTipoId], references: [id], onDelete: Cascade)
  clave          String
  etiqueta       String
  precioBase     Float?
  orden          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([servicioTipoId, clave])
  @@map("opcion_tamanios")
}

model AddonServicio {
  id        String   @id @default(uuid())
  clave     String   @unique
  etiqueta  String
  precioMin Float
  precioMax Float
  unidad    String
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addon_servicios")
}

model Cliente {
  id            String       @id @default(uuid())
  nombre        String
  apellido      String?
  email         String?
  telefono      String
  direccion     String
  ciudad        String       @default("Saint Cloud")
  estadoRegion  String       @default("MN")
  codigoPostal  String?
  notas         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  usuario       Usuario?
  cotizaciones  Cotizacion[]
  citas         Cita[]
  ventas        Venta[]

  @@map("clientes")
}

model Cotizacion {
  id                    String            @id @default(uuid())
  codigo                String            @unique
  clienteId             String
  cliente               Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipoLimpieza          TipoLimpieza      @default(ESTANDAR)
  tipoPropiedad         TipoPropiedad?
  piesCuadrados         Float?
  metrosCuadrados       Float?
  numHabitaciones       Int               @default(1)
  numBanos              Int               @default(1)
  tieneMascotas         Boolean           @default(false)
  serviciosExtra        String?
  totalEstimado         Float
  fechaExpira           DateTime?
  notas                 String?

  estado                EstadoCotizacion  @default(PENDIENTE)
  motivoRechazo         String?
  fechaRevision         DateTime?
  revisadoPorId         String?
  revisadoPor           Usuario?          @relation("RevisadoPor", fields: [revisadoPorId], references: [id])

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  citas                 Cita[]
  ventas                Venta[]

  @@map("cotizaciones")
}

model Cita {
  id                 String       @id @default(uuid())
  codigo             String       @unique
  clienteId          String
  cliente            Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  cotizacionId       String?
  cotizacion         Cotizacion?  @relation(fields: [cotizacionId], references: [id])

  fechaServicio      DateTime
  horaInicio         String
  horaFin            String
  personalAsignado   String?
  direccionServicio  String
  notas              String?

  estadoCita         EstadoCita   @default(PROGRAMADA)

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  venta              Venta?

  @@map("citas")
}

model Venta {
  id               String       @id @default(uuid())
  codigo           String       @unique
  clienteId        String
  cliente          Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  origen           OrigenVenta  @default(MANUAL)
  citaId           String?      @unique
  cita             Cita?        @relation(fields: [citaId], references: [id], onDelete: SetNull)
  cotizacionId     String?
  cotizacion       Cotizacion?  @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)

  tipoLimpieza     TipoLimpieza @default(ESTANDAR)
  fechaServicio    DateTime

  montoCotizado    Float        @default(0)
  montoFinal       Float?

  estadoPago       EstadoPago   @default(PENDIENTE)
  metodoPago       MetodoPago?
  fechaPago        DateTime?
  motivoAnulacion  String?
  notas            String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([estadoPago])
  @@index([fechaServicio])
  @@map("ventas")
}
